# ==============================================================================
# SharedBuy Production & Staging Environment Configuration (.env.example)
# ==============================================================================

# 1. Application Environment & HTTP Port
# Set APP_ENV=production before launch to disable all dev OTP (123456) bypasses
APP_ENV=production
PORT=8080

# 2. PostgreSQL Database Connection
DATABASE_URL=postgres://sharedbuy:sharedbuy_password@localhost:5434/sharedbuy?sslmode=disable

# 3. Authentication & CORS Security
# Generate a strong random secret (>= 32 bytes): openssl rand -hex 32
JWT_SECRET=replace-with-64-char-cryptographic-production-secret-key-2026
ALLOWED_ORIGINS=https://sharedbuy.ng,https://www.sharedbuy.ng,https://app.sharedbuy.ng

# 4. Paystack Payment & Transfer Gateway (Nigeria NGN Kobo)
# Register webhook URL in Paystack Dashboard: https://sharedbuy.ng/api/webhooks/paystack
PAYSTACK_SECRET_KEY=your_paystack_live_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_live_public_key_here

# 5. Termii SMS (Transactional DND) & WhatsApp Business API
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=SharedBuy
TERMII_BASE_URL=https://v3.api.termii.com

# 6. Evidence & Scale Photo Uploads
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=https://sharedbuy.ng

